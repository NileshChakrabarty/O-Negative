# O-Negative Environment Configuration Template
# Copy to .env and fill in your credentials

# LLM Configuration (Google Gemini)
GEMINI_API_KEY="your-gemini-api-key"

# Supabase Configuration (optional — falls back to SQLite)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_JWKS_URL="https://your-project.supabase.co/auth/v1/.well-known/jwks.json"
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# Government Data & Maps APIs (optional — has local fallbacks)
DATA_GOV_IN_API_KEY="your-data-gov-in-api-key"
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Notification Configuration
# "sandbox" = console output only (safe, no cost)
# "real" = Twilio SMS (requires TWILIO_* env vars)
NOTIFICATION_MODE="sandbox"

# Twilio (only needed if NOTIFICATION_MODE="real")
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""

# Backend Port
PORT=8000
